generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) tables ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts Account[]
  sessions Session[]

  bodyMetrics    BodyMetric[]
  inBodyScans    InBodyScan[]
  bloodworkPanels BloodworkPanel[]
  nutritionLogs  NutritionLog[]
  workouts       Workout[]
  dailyActivities DailyActivity[]
  goals          Goal[]
  importPresets  ImportPreset[]
  journalEntries JournalEntry[]
  chatMessages   ChatMessage[]
  fluidLogs      FluidLog[]

  ownedGroups      Group[]           @relation("GroupOwner")
  groupMemberships GroupMember[]
  sharePreferences SharePreference[]
  reactions        Reaction[]
  comments         Comment[]
  stravaConnection StravaConnection?

  createdAt DateTime @default(now())
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// --- Health data model ---

enum DataSource {
  MANUAL
  IMPORT
}

model BodyMetric {
  id          String     @id @default(cuid())
  userId      String
  date        DateTime
  weightLb    Float
  bodyFatPct  Float?
  device      String? // e.g. "Renpho", for smart-scale readings
  // Optional smart-scale extras (e.g. from a Renpho export)
  bmi                Float?
  skeletalMusclePct  Float?
  fatFreeMassLb      Float?
  subcutaneousFatPct Float?
  visceralFatLevel   Float?
  bodyWaterPct       Float?
  muscleMassLb       Float?
  boneMassLb         Float?
  proteinPct         Float?
  bmr                Int?
  metabolicAge       Int?
  // Tape-measure body measurements (inches)
  neckIn Float?
  waistIn Float?
  hipIn   Float?
  source      DataSource @default(MANUAL)
  sourceLabel String?
  notes       String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model InBodyScan {
  id                   String   @id @default(cuid())
  userId               String
  date                 DateTime
  weightLb             Float
  skeletalMuscleMassLb Float?
  bodyFatMassLb        Float?
  bodyFatPct           Float?
  visceralFatLevel     Float?
  bmr                  Int?
  inBodyScore          Int?
  // Segmental Lean Analysis (lb)
  rightArmLeanLb Float?
  leftArmLeanLb  Float?
  trunkLeanLb    Float?
  rightLegLeanLb Float?
  leftLegLeanLb  Float?
  // Segmental Lean Analysis (% of ideal per segment)
  rightArmLeanPct Float?
  leftArmLeanPct  Float?
  trunkLeanPct    Float?
  rightLegLeanPct Float?
  leftLegLeanPct  Float?
  // Segmental Fat Analysis (lb)
  rightArmFatLb Float?
  leftArmFatLb  Float?
  trunkFatLb    Float?
  rightLegFatLb Float?
  leftLegFatLb  Float?
  // Water / cell composition
  totalBodyWaterL       Float?
  intracellularWaterL   Float?
  extracellularWaterL   Float?
  ecwRatio              Float?
  bodyCellMassLb        Float?
  smi                   Float?
  phaseAngle            Float?
  notes                String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model BloodworkPanel {
  id        String            @id @default(cuid())
  userId    String
  date      DateTime
  labName   String?
  notes     String?
  createdAt DateTime          @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  markers BloodworkMarker[]

  @@index([userId, date])
}

model BloodworkMarker {
  id       String  @id @default(cuid())
  panelId  String
  name     String
  value    Float
  unit     String?
  refLow   Float?
  refHigh  Float?

  panel BloodworkPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@index([panelId])
  @@index([name])
}

model NutritionLog {
  id        String     @id @default(cuid())
  userId    String
  date      DateTime
  calories  Float
  proteinG  Float?
  carbsG    Float?
  fatG      Float?
  sodiumMg  Float?
  sugarG    Float?
  notes     String?
  source    DataSource @default(MANUAL)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model FluidLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  drinkType String // "Water" | "Coffee" | "Tea" | "Soda" | "Juice" | "Alcohol" | "Other"
  amountOz  Float
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Workout {
  id              String     @id @default(cuid())
  userId          String
  date            DateTime
  type            String
  durationMin     Float
  caloriesBurned  Float?
  distanceKm      Float?
  trackedWith     String?
  metrics         Json?
  routePoints     Json?
  stravaActivityId String?   @unique
  source          DataSource @default(MANUAL)
  createdAt       DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model JournalEntry {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime
  moodRating    Int?
  entry         String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model DailyActivity {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime
  steps            Int?
  activeCalories   Float?
  exerciseMinutes  Float?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

enum GoalType {
  WEIGHT
  BODY_FAT
  EXERCISE
  EXERCISE_REPS
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ABANDONED
}

model Goal {
  id           String     @id @default(cuid())
  userId       String
  type         GoalType
  exerciseName String? // only for EXERCISE_REPS, e.g. "Strict Pull-ups"
  startValue   Float
  startDate    DateTime
  targetValue  Float
  targetDate   DateTime?
  status       GoalStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime   @default(now())

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressLogs GoalProgressLog[]

  @@index([userId, status])
}

model GoalProgressLog {
  id        String   @id @default(cuid())
  goalId    String
  date      DateTime
  value     Float
  notes     String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
}

enum ImportDataType {
  BODY_METRIC
  NUTRITION_LOG
  WORKOUT
  DAILY_ACTIVITY
}

model ImportPreset {
  id             String         @id @default(cuid())
  userId         String
  name           String
  dataType       ImportDataType
  columnMapping  Json
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

// --- Family / accountability sharing ---

enum ShareCategory {
  WORKOUT
  GOAL
}

enum FeedItemType {
  WORKOUT
  GOAL
}

model Group {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner            User              @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members          GroupMember[]
  sharePreferences SharePreference[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// Per-group, per-category opt-in: does this user share this category of
// data with this specific group? Defaults to off — sharing is always
// explicit, never implied by group membership alone.
model SharePreference {
  id       String        @id @default(cuid())
  userId   String
  groupId  String
  category ShareCategory
  enabled  Boolean       @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, category])
}

// Reactions/comments reference a Workout or Goal by id rather than a
// separate "post" table, so the feed always reflects the same data you see
// on your own Workout/Goals pages — no duplicated/stale copies.
model Reaction {
  id        String       @id @default(cuid())
  userId    String
  itemType  FeedItemType
  itemId    String
  emoji     String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId, emoji])
  @@index([itemType, itemId])
}

model Comment {
  id        String       @id @default(cuid())
  userId    String
  itemType  FeedItemType
  itemId    String
  body      String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([itemType, itemId])
}

// --- Strava integration ---

model StravaConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  athleteId    String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
