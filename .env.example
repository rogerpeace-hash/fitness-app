# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/fitness_app?schema=public"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Restrict sign-in to these email addresses (comma-separated). Each person
# signs in with their own Google account and only ever sees their own data.
ALLOWED_EMAILS="you@example.com,spouse@example.com"

# Google OAuth credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-deployed-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ESV Bible API key for the daily verse popup (free): https://api.esv.org/account/create-application/
ESV_API_KEY=""

# Anthropic API key for the Coach chat (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Your deployed app's URL, used to build the Strava OAuth callback link
APP_URL="https://your-app.fly.dev"

# Strava API app: https://www.strava.com/settings/api
# Authorization Callback Domain must match APP_URL's domain (no https://, no path)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
